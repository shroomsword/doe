#!/usr/bin/env bash
# Build the library for WebAssembly without the filesystem, and run the tests
# that need no files (crates/doe/tests/limits.rs) in a WebAssembly runtime.
#
# usage: scripts/wasm-test
#
# Needs the targets wasm32-unknown-unknown and wasm32-wasip1 (`rustup target
# add`) and Node.js (its built-in WASI runs the tests; no other tool).
#
# The browser target cannot run tests without extra tools, so the tests run as
# wasm32-wasip1, which has the same 1 MiB stack. A stack overflow in the
# library fails them.
set -euo pipefail

root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
cd "$root"

# Optimised, as a library that is shipped to a browser is. WebAssembly has a
# stack of 1 MiB, and unoptimised frames of the YAML reader are large enough
# that a schema nested as deeply as the reader allows (64 levels) overflows it
# (`memory access out of bounds`); optimised, it is a small part of the stack.
# Set the variable to 0 to see it.
export CARGO_PROFILE_DEV_OPT_LEVEL="${CARGO_PROFILE_DEV_OPT_LEVEL:-2}"
export CARGO_PROFILE_DEV_DEBUG="${CARGO_PROFILE_DEV_DEBUG:-0}"

echo "== build for wasm32-unknown-unknown (no default features)"
cargo build -p doe --no-default-features --target wasm32-unknown-unknown --locked

echo "== tests on wasm32-wasip1 (node $(node --version))"
export CARGO_TARGET_WASM32_WASIP1_RUNNER="node $root/scripts/wasm-runner.mjs"
test_cmd=(cargo test -p doe --no-default-features --test limits --target wasm32-wasip1 --locked)

# Each test runs in a process of its own, so that one that crashes the runtime
# (a stack overflow in the library) is named, and the others still run.
mapfile -t tests < <("${test_cmd[@]}" -- --list --format terse 2>/dev/null | sed -n 's/: test$//p')
[[ ${#tests[@]} -gt 0 ]] || { echo "no tests were found" >&2; exit 1; }
failed=0
for name in "${tests[@]}"; do
  if output=$("${test_cmd[@]}" -- --exact "$name" 2>&1); then
    echo "ok   $name"
  else
    echo "FAIL $name"
    echo "$output" | tail -15
    failed=1
  fi
done
exit "$failed"
